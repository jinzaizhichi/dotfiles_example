#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias ls='ls --color=auto'
alias grep='grep --color=auto'
PS1='[\u@\h \W]\$ '

# Source global definitions
if [ -f /etc/bashrc ]; then
	. /etc/bashrc
fi

# User specific environment
if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/bin:" ]]
then
    PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi
export PATH

# Uncomment the following line if you don't like systemctl's auto-paging feature:
# export SYSTEMD_PAGER=

# User specific aliases and functions
if [ -d ~/.bashrc.d ]; then
	for rc in ~/.bashrc.d/*; do
		if [ -f "$rc" ]; then
			. "$rc"
		fi
	done
fi

unset rc
# vim & zed aliases
alias vim='nvim'
alias vi="nvim"
alias vimdiff='nvim -d'
alias zed="WAYLAND_DISPLAY='' zeditor"
export EDITOR=nvim
export SYSTEMD_EDITOR=nvim

# other tool aliases
alias grep-dir="grep -rnw . -e "

# system aliases
alias open='xdg-open'
alias sh-edit='chezmoi edit --apply ~/.bashrc && . ~/.bashrc'
alias sh-upd='. ~/.bashrc'

alias key-init='sudo rm -rf /etc/pacman.d/gnupg && sudo pacman -Sy --noconfirm archlinux-keyring cachyos-keyring && sudo pacman-key --init && sudo pacman-key --populate archlinux cachyos'
alias key-upd='sudo pacman-key —refresh-keys'

alias mirror-upd='sudo cachyos-rate-mirrors'

alias sys-upd='yay -Syu ; flatpak update ; sudo fwupdmgr update ; sudo checkservices'
alias sys-enc='sudo systemd-cryptenroll --tpm2-device=auto --wipe-slot=tpm2 /dev/disk/by-label/root'
alias sys-arm='yay -Scc; sudo pacman -Qdttq | sudo pacman -Rs - ; flatpak uninstall --unused ; sudo pacman -S --needed gnome'
alias sys-bios='systemctl reboot --firmware-setup'
alias sys-enc='sudo systemd-cryptenroll --tpm2-device=auto --wipe-slot=tpm2 /dev/disk/by-label/root'
alias sys-initram='sudo mkinitcpio -P'

alias gdm-upd='sudo cp ~/.config/monitors.xml /var/lib/gdm/.config/'
alias group-list="sudo pacman -Sg group"

# command not found on arch linux
source /usr/share/doc/pkgfile/command-not-found.bash

# git aliases
function git-upd() {
    git add . && git commit -m "$1" && git push
}
alias git-cd='cd ~/git'


# mpv and yt-dl aliases
alias mpv-audio='mpv --no-video'
alias yt-dlaudio='yt-dlp -f "bestaudio"'
alias rip-mp3='mkdir mp3s && for f in *.opus; do ffmpeg -i "$f" -c:a libmp3lame "mp3s/${f%.webm}.mp3"; done'
alias rip-aac='mkdir aacs && for f in *.opus; do ffmpeg -i "$f" -c:a aac "aacs/${f%.webm}.m4a"; done'

# arch packaging aliases
alias makepkg-srcinfo='makepkg --printsrcinfo > .SRCINFO'
alias makepkg-cleanbuild='makepkg -Cfis'
alias makepkg-rebuild='makepkg -isf'
alias makepkg-upd='pkgctl version upgrade'

# snapper alias
alias snapper-clean="sudo snapper cleanup number"
alias snapper-list="sudo snapper list"
alias fstab-chk="sudo findmnt --verify --verbose"

#source ~/vulkansdk/1.3.224.1/setup-env.sh

#rust
export PATH="$HOME/.cargo/bin:$PATH"

#ruby
eval "$(rv shell init bash)"

#python
alias venv-enter="source .venv/bin/activate"

#dotnet
export PATH="$HOME/.dotnet/tools:$PATH"
eval "$(dotnet completions script bash)"

#cmake
export CMAKE_GENERATOR="Ninja"
export CC="/usr/bin/clang"
export CXX="/usr/bin/clang++"
alias cmake-run-build="cmake -B build -S . -GNinja && cmake --build build"
alias cmake-clean-build="rm -rf build && cmake -B build -S . -GNinja && cmake --build build"


# cachyos debuginfo url
export DEBUGINFOD_URLS="https://debuginfod.archlinux.org https://debuginfod.cachyos.org https://debuginfod.elfutils.org/"

