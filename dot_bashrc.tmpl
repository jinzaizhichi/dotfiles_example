{{- if eq .chezmoi.hostname "pranv-b550" }}

#leetcode cli
eval "$(leetcode completions)"

# btrfs maintaince
function btrfs-balance() {
    for fs in / /home/pranav/tierone /home/pranav/tiertwo /home/pranav/tierfreeze; do
        echo "running on $fs ..."
        sudo btrfs balance start -dusage=10 -musage=5 $fs
        sudo btrfs balance start -dusage=50 -musage=30 $fs
        sudo btrfs balance start -dusage=10 -musage=5 $fs
        echo "done with $fs!"
        echo ""
    done
}

alias btrfs-usage="sudo btrfs filesystem usage / /home/pranav/tierone /home/pranav/tiertwo /home/pranav/tierfreeze"

function fs-trim() {
    for fs in / /home/pranav/tierone /home/pranav/tiertwo /home/pranav/tierfreeze; do
        echo "running on $fs ..."
        sudo ftrim -v $fs
        echo "done with $fs!"
        echo ""
    done
}

alias btrfs-usage-desktop="sudo btrfs filesystem usage / /home/pranav/tierone /home/pranav/tiertwo /home/pranav/tierfreeze"

#snapd
export PATH="/var/lib/snapd/snap/bin:$PATH" 

#podman
